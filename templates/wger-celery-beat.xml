<?xml version="1.0"?>
<Container version="2">
  <Name>wger-celery-beat</Name>
  <Repository>wger/server:latest</Repository>
  <Registry>https://registry.hub.docker.com/r/wger/server</Registry>
  <Network>wger_network</Network>
  <Shell>sh</Shell>
  <Privileged>false</Privileged>
  <Support>https://github.com/wger-project/docker/issues</Support>
  <Project>https://wger.de</Project>
  <Overview>Celery Beat scheduler that manages periodic tasks for the wger application (automatic exercise sync, cleanup, etc.).</Overview>
  <Category>Tools:</Category>
  <WebUI/>
  <TemplateURL>https://raw.githubusercontent.com/rorar/unraid-templates/main/templates/wger-celery-beat.xml</TemplateURL>
  <Icon>https://raw.githubusercontent.com/rorar/unraid-templates/main/templates/docker_icons/wger-logo.png</Icon>
  <ExtraParams>--entrypoint /start-beat</ExtraParams>
  <Date>2026-05-26</Date>
  <Requires>Part of the wger stack. Must be on the same Docker network (wger_network) as wger-server, wger-db, and wger-redis.</Requires>
  <Config Name="SECRET_KEY" Target="SECRET_KEY" Default="wger-docker-supersecret-key-1234567890!@#$%^&amp;amp;*(-_)" Mode="" Description="Django SECRET_KEY &#x2013; must match wger-server. CHANGE THIS!" Type="Variable" Display="always" Required="true" Mask="false">wger-docker-supersecret-key-1234567890!@#$%^&amp;*(-_)</Config>
  <Config Name="SIGNING_KEY" Target="SIGNING_KEY" Default="wger-docker-secret-jwtkey-1234567890!@#$%^&amp;amp;*(-_=+)" Mode="" Description="JWT signing key &#x2013; must match wger-server. CHANGE THIS!" Type="Variable" Display="always" Required="true" Mask="false">wger-docker-secret-jwtkey-1234567890!@#$%^&amp;*(-_=+)</Config>
  <Config Name="TIME_ZONE" Target="TIME_ZONE" Default="Europe/Berlin" Mode="" Description="Timezone (must match wger-server)" Type="Variable" Display="always" Required="true" Mask="false">Europe/Berlin</Config>
  <Config Name="DJANGO_DB_HOST" Target="DJANGO_DB_HOST" Default="wger-db" Mode="" Description="Database container hostname" Type="Variable" Display="always" Required="false" Mask="false">wger-db</Config>
  <Config Name="CELERY_BROKER" Target="CELERY_BROKER" Default="redis://wger-redis:6379/2" Mode="" Description="Celery broker URL (Redis)" Type="Variable" Display="always" Required="false" Mask="false">redis://wger-redis:6379/2</Config>
  <Config Name="CELERY_BACKEND" Target="CELERY_BACKEND" Default="redis://wger-redis:6379/2" Mode="" Description="Celery result backend URL (Redis)" Type="Variable" Display="always" Required="false" Mask="false">redis://wger-redis:6379/2</Config>
  <Config Name="PUID" Target="PUID" Default="99" Mode="" Description="User ID" Type="Variable" Display="always" Required="false" Mask="false">99</Config>
  <Config Name="PGID" Target="PGID" Default="100" Mode="" Description="Group ID" Type="Variable" Display="always" Required="false" Mask="false">100</Config>
  <Config Name="UMASK" Target="UMASK" Default="022" Mode="" Description="File creation mask" Type="Variable" Display="always" Required="false" Mask="false">022</Config>
</Container>

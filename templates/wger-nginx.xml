<?xml version="1.0"?>
<Container version="2">
  <Name>wger-nginx</Name>
  <Repository>nginx:stable</Repository>
  <Registry>https://registry.hub.docker.com/_/nginx</Registry>
  <Network>wger_network</Network>
  <Shell>sh</Shell>
  <Privileged>false</Privileged>
  <Support>https://github.com/wger-project/docker/issues</Support>
  <Project>https://wger.de</Project>
  <Overview>Nginx reverse proxy that serves static content from shared volumes and forwards requests to the wger server.</Overview>
  <Category>Network:Proxy</Category>
  <WebUI>http://[IP]:[PORT:8557]</WebUI>
  <TemplateURL>https://raw.githubusercontent.com/rorar/unraid-templates/main/templates/wger-nginx.xml</TemplateURL>
  <Icon>https://raw.githubusercontent.com/rorar/unraid-templates/main/templates/docker_icons/wger-logo.png</Icon>
  <ExtraParams>--health-cmd="service nginx status" --health-interval=10s --health-retries=5 --health-start-period=30s --health-timeout=5s</ExtraParams>
  <Date>2026-05-26</Date>
  <Requires>Part of the wger stack. Must be on the same Docker network (wger_network) as wger-server.</Requires>
  <Config Name="PORT" Target="80" Default="8557" Mode="tcp" Description="HTTP port for the nginx container (container port 80)" Type="Port" Display="always" Required="true" Mask="false">8557</Config>
  <Config Name="NGINX_CONFIG" Target="/etc/nginx/conf.d/" Default="/mnt/user/appdata/wger/nginx/" Mode="ro" Description="Path to nginx configuration" Type="Path" Display="always" Required="true" Mask="false">/mnt/user/appdata/wger/nginx/</Config>
  <Config Name="STATIC_ROOT" Target="/wger/static" Default="/mnt/user/appdata/wger/static/" Mode="ro" Description="Path to static files (read-only)" Type="Path" Display="always" Required="true" Mask="false">/mnt/user/appdata/wger/static/</Config>
  <Config Name="MEDIA_ROOT" Target="/wger/media" Default="/mnt/user/appdata/wger/media/" Mode="ro" Description="Path to media files (read-only)" Type="Path" Display="always" Required="true" Mask="false">/mnt/user/appdata/wger/media/</Config>
  <Config Name="PUID" Target="PUID" Default="99" Mode="" Description="User ID" Type="Variable" Display="always" Required="false" Mask="false">99</Config>
  <Config Name="PGID" Target="PGID" Default="100" Mode="" Description="Group ID" Type="Variable" Display="always" Required="false" Mask="false">100</Config>
  <Config Name="UMASK" Target="UMASK" Default="022" Mode="" Description="File creation mask" Type="Variable" Display="always" Required="false" Mask="false">022</Config>
</Container>
